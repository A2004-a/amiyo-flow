# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force CRLF for Windows scripts
*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.bin binary
*.gguf binary
*.wav binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
